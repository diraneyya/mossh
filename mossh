#!/usr/bin/env bash

# Parse command-line arguments
REMOTE_JUMP_MOSH_PORTS="60001:60008"
REMOTE_JUMP_SSH_NAME=""
SSH_JUMP_ARGS=()

show_help() {
    cat <<'HELP'
mossh - Mobile Shell with SSH jump capability

Usage: mossh [options] <host> [destination]

Establish a durable terminal session using the mobile shell (Mosh),
optionally jump to another host using SSH.

Arguments:
  host          SSH config name for the remote server (required)
  destination   Optional host to SSH into after Mosh connection

Options:
  -p <ports>    UDP port range for Mosh (default: 60001:60008)
                Can be a single port (60010) or range (60010:60020)
  -h, --help    Show this help message

Examples:
  mossh myserver                        # Connect to myserver via Mosh
  mossh myserver internal               # Mosh to myserver, then SSH to internal
  mossh -p 60010:60020 myserver         # Use custom port range
  mossh -p 60010 myserver internal      # Single port with SSH jump

Environment Variables:
  DEBUG         Enable debug output if set

Requirements:
  - Remote configured in ~/.ssh/config on the local machine
  - Hosts configured in ~/.ssh/config on the remote, if using SSH for jumping
  - UDP ports open on remote server
HELP
}

# Parse options
while [[ $# -gt 0 ]]; do
    # Once we have the host, everything else goes to SSH
    if [[ -n "$REMOTE_JUMP_SSH_NAME" ]]; then
        SSH_JUMP_ARGS+=("$1")
        shift
        continue
    fi

    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -p)
            if [[ -z "${2:-}" ]]; then
                echo "Error: -p option requires a port or port range argument" >&2
                echo "Try 'mossh --help' for more information." >&2
                exit 1
            fi
            REMOTE_JUMP_MOSH_PORTS="$2"
            shift 2
            ;;
        -*)
            echo "Error: Unknown option: $1" >&2
            echo "Try 'mossh --help' for more information." >&2
            exit 1
            ;;
        *)
            # First positional argument is the host
            REMOTE_JUMP_SSH_NAME="$1"
            shift
            ;;
    esac
done

# Check if host was specified
if [[ -z "$REMOTE_JUMP_SSH_NAME" ]]; then
    echo "Error: No host specified" >&2
    echo "Try 'mossh --help' for more information." >&2
    exit 1
fi

# Remote functions
plan_mosh_install() {
    if command -v mosh-server >/dev/null 2>&1; then
        return 0
    fi

    # Interactivity flag, when called without an argument
    # the assumption is that interactive invocation of sudo
    # will be allowed, which means that the INSTALL_COMMAND
    # will have to be executed using `ssh -t` (for granting
    # a TTY)
    if [ -n "$2" ]; then 
        sudo="sudo -n"
    else 
        sudo="sudo"
    fi

    if command -v apt-get >/dev/null 2>&1; then
        INSTALL_COMMAND="$sudo apt-get update && $sudo apt-get install -y mosh"
    elif command -v yum >/dev/null 2>&1; then
        INSTALL_COMMAND="$sudo yum install -y mosh"
    elif command -v dnf >/dev/null 2>&1; then
        INSTALL_COMMAND="$sudo dnf install -y mosh"
    elif command -v pacman >/dev/null 2>&1; then
        INSTALL_COMMAND="$sudo pacman -S --noconfirm mosh"
    elif command -v brew >/dev/null 2>&1; then
        INSTALL_COMMAND="brew install mosh"
    # OpenWRT
    elif command -v opkg >/dev/null 2>&1; then
        INSTALL_COMMAND="opkg update && opkg install mosh-server"
    else
        echo "No package manager(s) found $1"
        return 1
    fi
    echo "$INSTALL_COMMAND"
    return 0
}

# This function should run on sh, ash, bash, and zsh
execute_on_the_remote() {
    if [ "$1" = "ssh" ]; then
        # Check if only one argument
        if [ $# -eq 1 ]; then 
            if [ -n "$SHELL" ]; then 
                "$SHELL" -l
            else 
                sh -l
            fi
        else 
            ssh_output_file=$(mktemp)
            # Shift past first argument to get remaining args
            shift
            if ssh -T "$@" true 2>"$ssh_output_file"; then
                rm "$ssh_output_file"
                exec ssh "$@"
            else 
                echo "Error: jumping via \"ssh $*\" failed: $(cat "$ssh_output_file")" >&2
                rm "$ssh_output_file"
                exit 1
            fi
        fi
    fi
}

# Enable debug mode if requested
if [[ -n "${DEBUG:-}" ]]; then set -x; fi

# Get SSH configuration
REMOTE_JUMP_SSH_HOST=$(ssh -G "$REMOTE_JUMP_SSH_NAME" | awk '/^hostname / {print $2; exit}')
REMOTE_JUMP_SSH_PORT=$(ssh -G "$REMOTE_JUMP_SSH_NAME" | awk '/^port / {print $2; exit}')
REMOTE_JUMP_SSH_USER=$(ssh -G "$REMOTE_JUMP_SSH_NAME" | awk '/^user / {print $2; exit}')

# if [[ "$REMOTE_JUMP_SSH_USER" == "$USER" ]]; then 
#     unset REMOTE_JUMP_SSH_USER
# fi

if [[ -z "$REMOTE_JUMP_SSH_HOST" || -z "$REMOTE_JUMP_SSH_PORT" ]]; then
    echo "Error: SSH host '$REMOTE_JUMP_SSH_NAME' is not configured in ~/.ssh/config" >&2
    exit 1
fi

host_resolution="$(grep -E "^[^#]*\s+$REMOTE_JUMP_SSH_HOST(\s|$)" \
    /etc/hosts | awk '{print $1}' | head -1)"
if [[ -n "$host_resolution" ]]; then 
    echo "Host '$REMOTE_JUMP_SSH_HOST' resolved to '$host_resolution'"
    REMOTE_JUMP_SSH_HOST="$host_resolution"
fi

# Build SSH command array
ssh_command=("ssh" "-p" "$REMOTE_JUMP_SSH_PORT")
if [[ -n "${REMOTE_JUMP_SSH_USER:-}" ]]; then 
    ssh_command+=("-l" "$REMOTE_JUMP_SSH_USER")
fi

# Install mosh locally if needed
if ! plan_mosh_install 'locally'; then 
    echo "Error: Failed to install mosh locally using '$INSTALL_COMMAND'" >&2
    exit 1
fi

# Verify basic SSH connectivity to the (jump) remote and
# use the LocalCommand option to indirectly resolve hosts
# (a better alternative to accessing /etc/hosts)
rm /tmp/mossh.host 2>/dev/null
public_ip_alternative="$( \
    "${ssh_command[@]}" -T \
    -o PermitLocalCommand=yes \
    -o LocalCommand='echo -n "%h" > /tmp/mossh.host' \
    "$REMOTE_JUMP_SSH_HOST" '
        if command -v curl 2>/dev/null 1>&2; then 
            IP="$(curl -s -6 ifconfig.me)"
            if [[ -z "$IP" ]]; then 
                IP="$(curl -s -4 ifconfig.me)"
                if [[ -z "$IP" ]]; then 
                    exit 0
                fi
            fi
            echo "$IP"
        fi
    '
)"

if [[ $? -ne 0 ]]; then
    echo "Error: '$REMOTE_JUMP_SSH_HOST' unknown or in-accessible via SSH" >&2
    rm /tmp/mossh.host 2>/dev/null
    exit 1
fi

if [[ -n "$public_ip_alternative" && \
    "$REMOTE_JUMP_SSH_HOST" != "$public_ip_alternative" ]]; then
    echo "Host '$REMOTE_JUMP_SSH_HOST' has the public IP $public_ip_alternative"
fi

if [[ -f '/tmp/mossh.host' ]]; then
    resolved_hostname="$(cat /tmp/mossh.host)"
    if [[ "$resolved_hostname" != "$REMOTE_JUMP_SSH_HOST" ]]; then 
        echo "Host '$REMOTE_JUMP_SSH_HOST' resolved to '$resolved_hostname'"
        REMOTE_JUMP_SSH_HOST="$resolved_hostname"
    fi
fi

rm /tmp/mossh.host 2>/dev/null

# Install mosh on the jump server if needed, then obtain
# the external IP address of the host being jumped to via
# SSH, favouring IPv6 over IPv4. If no jumping takes place
# then we use the IP address used for the connection.
# (the underlying assumption here is that, if the host is
# accessible directly, then there should be no reason to
# use SSH for jumping and we should connect directly -not
# always true but a simplifying assumption in this case)
if echo "$REMOTE_JUMP_SSH_HOST" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
    public_ip="$REMOTE_JUMP_SSH_HOST"
fi

# Not perfect and you can face issues if you use '#' inside
# of a string for example
serialized_function="$( \
    echo -n "$(declare -f plan_mosh_install)" | \
    sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d')"

output_fifo='/tmp/mossh.install_output_fifo'
output_file='/tmp/mossh.install_output_file'

rm "$output_fifo" 2>/dev/null
rm "$output_file" 2>/dev/null

mkfifo "$output_fifo"

while read -d ' ' word; do 
    printf "\e[32m%s \e[0m\e[0K" "$word"
    echo -n "$word " >> "$output_file" 
done < "$output_fifo" &

"${ssh_command[@]}" -t \
    "$REMOTE_JUMP_SSH_HOST" "
    $serialized_function
    plan_mosh_install 'on the remote' || exit \$?
    INSTALL_COMMAND=\"\$(echo \"\$INSTALL_COMMAND\" | \
        sed 's/sudo/sudo -p \"[%H] password for %U: \"/')\"
    eval \"\$INSTALL_COMMAND\" || exit \$?
    " 1>"$output_fifo" 2>/dev/null

if [[ $? -ne 0 ]]; then
    printf "\r\e[0K\e[31mError: Failed to install mosh on remote\e[0m\e[0K\n" >&2
    printf "\rPlease SSH into the remote and install mosh using:\n"
    printf "\e[1;33m%s\e[0m\n" "$(head -n 1 "$output_file")"

    rm "$output_fifo" 2>/dev/null
    rm "$output_file" 2>/dev/null
    exit 1
fi

rm "$output_fifo" 2>/dev/null
rm "$output_file" 2>/dev/null

if [[ -n "${SSH_JUMP_ARGS[*]}" && -n "$public_ip_alternative" ]]; then 
    public_ip="$public_ip_alternative"
fi

if [[ -z "$public_ip" ]]; then 
    echo "Error: Failed to retrieve connection IP on remote" >&2
    exit 1
fi

# Build properly quoted arguments for remote SSH execution
remote_args=""
for arg in "${SSH_JUMP_ARGS[@]}"; do
    remote_args="$remote_args $(printf '%q' "$arg")"
done

# Fix locale - ensure we have a proper UTF-8 locale
# LC_CTYPE must be a full locale (e.g., en_US.UTF-8), not just "UTF-8"
if [[ -z "${LC_CTYPE:-}" ]] || [[ "$LC_CTYPE" != *.UTF-8 && "$LC_CTYPE" != *.utf8 ]]; then
    export LANG="en_US.UTF-8"
    export LC_CTYPE="en_US.UTF-8"
fi

# Spin up the mosh-server on the remote
server_output="$(
    "${ssh_command[@]}" "$REMOTE_JUMP_SSH_HOST" \
    "mosh-server new -s \
        -p $REMOTE_JUMP_MOSH_PORTS \
        -c $(mosh-client -c) \
        -l LC_CTYPE=UTF-8 \
        -- \$SHELL -c '
            $(declare -f execute_on_the_remote)
            execute_on_the_remote ssh$remote_args
        ' 2>&1"
)"
connect_string="$(echo "$server_output" | grep 'MOSH CONNECT')"

if [[ $? -ne 0 || -z "$connect_string" ]]; then
    echo "Error: failed to spin up mosh-server on the remote '$REMOTE_JUMP_SSH_NAME'" >&2
    printf "\e[1;2;4m%s:\e[22;24;2m %s\e[0m\n" "DETAILS" "$server_output"
    exit 1
fi

# Read connection parameters, which will be used by the client
read _ _ MOSH_PORT MOSH_KEY <<< "$connect_string"

# Invoke the client
echo "Mosh will connect to $public_ip on port $MOSH_PORT"

export MOSH_KEY
set -x
exec mosh-client $public_ip $MOSH_PORT